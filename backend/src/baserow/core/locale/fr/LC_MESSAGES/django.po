msgstr ""
"Votre compte (%(username)s) sur Baserow "
"(%(baserow_embedded_share_hostname)s) a été définitivement supprimé."

#: src/baserow/core/templates/baserow/core/user/account_deletion_cancelled.html:173
msgid "Account deletion cancelled"
msgstr "Suppression du compte annulée"

#: src/baserow/core/templates/baserow/core/user/account_deletion_cancelled.html:178
#, python-format
msgid ""
"Your account (%(username)s) on Baserow (%(baserow_embedded_share_hostname)s) "
