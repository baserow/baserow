"cancelled."
msgstr ""
"Votre compte (%(username)s) sur Baserow "
"(%(baserow_embedded_share_hostname)s) était en attente de suppression, mais "
"votre connexion a annulé cette opération."

#: src/baserow/core/templates/baserow/core/user/account_deletion_scheduled.html:173
msgid "Account pending deletion"
msgstr "Compte en attente de suppression"

#: src/baserow/core/templates/baserow/core/user/account_deletion_scheduled.html:178
#, python-format
