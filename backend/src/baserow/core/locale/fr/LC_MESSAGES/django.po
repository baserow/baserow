msgstr "Mot de passe modifié"

#: src/baserow/core/templates/baserow/core/user/password_changed.html:178
#, python-format
msgid ""
"The password for your account (%(username)s) on Baserow "
"(%(baserow_embedded_share_hostname)s) has been successfully changed."
msgstr ""
"Le mot de passe de votre compte (%(username)s) sur Baserow "
"(%(baserow_embedded_share_hostname)s) a été modifié."

#: src/baserow/core/templates/baserow/core/user/password_changed.html:183
