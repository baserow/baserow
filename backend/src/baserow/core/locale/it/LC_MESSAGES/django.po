#: src/baserow/core/templates/baserow/core/user/reset_password.html:207
#: src/baserow/core/templates/baserow/core/workspace_invitation.html:207
msgid ""
"Baserow is an open source no-code database tool which allows you to "
"collaborate on projects, customers and more. It gives you the powers of a "
"developer without leaving your browser."
msgstr ""
"Baserow é un database no-code open source che permette di collaborare su "
"progetti, clienti ed altro. Ti da i \"poteri\" di uno sviluppatore senza "
"lasciare il tuo browser."

#: src/baserow/core/templates/baserow/core/user/account_deleted.html:173
msgid "Account permanently deleted"
msgstr "Account eliminato in modo definitivo"

#: src/baserow/core/templates/baserow/core/user/account_deleted.html:178
#, python-format
msgid ""
"Your account (%(username)s) on Baserow (%(baserow_embedded_share_hostname)s) "
"has been permanently deleted."
msgstr ""
"Il tuo account (%(username)s) su Baserow "
"(%(baserow_embedded_share_hostname)s) è stato eliminato in modo definitivo."

#: src/baserow/core/templates/baserow/core/user/account_deletion_cancelled.html:173
msgid "Account deletion cancelled"
msgstr "Procedura di cancellazione account interrotta"

#: src/baserow/core/templates/baserow/core/user/account_deletion_cancelled.html:178
#, python-format
msgid ""
"Your account (%(username)s) on Baserow (%(baserow_embedded_share_hostname)s) "
"was pending deletion, but you've logged in so this operation has been "
"cancelled."
msgstr ""
"Il tuo account (%(username)s) su Baserow "
"(%(baserow_embedded_share_hostname)s) era in attesa di essere cancellato. Il "
"tuo nuovo login ha interrotto la procedura di cancellazione e ripristinato "
"il tuo account."

#: src/baserow/core/templates/baserow/core/user/account_deletion_scheduled.html:173
msgid "Account pending deletion"
msgstr "Procedura di cancellazione account"

#: src/baserow/core/templates/baserow/core/user/account_deletion_scheduled.html:178
#, python-format
msgid ""
"Your account (%(username)s) on Baserow (%(baserow_embedded_share_hostname)s) "
"will be permanently deleted in %(days_left)s days."
msgstr ""
"Il tuo account (%(username)s) su Baserow "
"(%(baserow_embedded_share_hostname)s) verrà eliminato in modo definitivo tra "
"%(days_left)s giorni."

#: src/baserow/core/templates/baserow/core/user/account_deletion_scheduled.html:183
msgid ""
"If you've changed your mind and want to cancel your account deletion, you "
"just have to login again."
msgstr ""
"Puoi interrompere la procedura di cancellazione in ogni momento "
"semplicemente effettuando un nuovo login con il tuo account."

#: src/baserow/core/templates/baserow/core/user/change_email_confirmation.html:173
msgid "Confirm email address change"
msgstr "Conferma la modifica dell'indirizzo email"

#: src/baserow/core/templates/baserow/core/user/change_email_confirmation.html:178
#, python-format
msgid ""
"A request was made to change the email address for your Baserow account from "
"%(old_email)s to %(new_email)s on Baserow "
"(%(baserow_embedded_share_hostname)s). If you did not authorize this, you "
"may simply ignore this email."
msgstr ""
"È stata richiesta la modifica dell'indirizzo email del tuo account Baserow "
"da %(old_email)s a %(new_email)s su Baserow "
"(%(baserow_embedded_share_hostname)s). Se non hai autorizzato questa "
"richiesta, puoi semplicemente ignorare questa email."

#: src/baserow/core/templates/baserow/core/user/change_email_confirmation.html:183
#, python-format
msgid ""
"To confirm your email address change, simply click the button below. This "
"link will expire in %(hours)s hours."
msgstr ""
"Per confermare la modifica del tuo indirizzo email, clicca sul pulsante qui "
"sotto. Questo link scadrà tra %(hours)s ore."

#: src/baserow/core/templates/baserow/core/user/change_email_confirmation.html:192
msgid "Confirm email change"
msgstr "Conferma il cambio email"

#: src/baserow/core/templates/baserow/core/user/email_pending_verification.html:178
msgid "Thank you for using Baserow"
msgstr "Grazie per usare Baserow"

#: src/baserow/core/templates/baserow/core/user/email_pending_verification.html:183
msgid ""
"To keep your account secure, please take a moment to verify your email by "
"clicking the button below. Your email address will be used to assist you in "
"changing your Baserow password should you ever need to in the future."
msgstr ""
"Per mantenere sicuro il tuo account, prenditi un momento per verificare la "
"tua email cliccando sul pulsante qui sotto. Il tuo indirizzo email verrà "
"usato per aiutarti a modificare la password di Baserow, qualora ne avessi "
"bisogno in futuro."

#: src/baserow/core/templates/baserow/core/user/email_pending_verification.html:192
msgid "Confirm"
msgstr "Conferma"

#: src/baserow/core/templates/baserow/core/user/password_changed.html:173
msgid "Password changed"
msgstr "Password modificata"

#: src/baserow/core/templates/baserow/core/user/password_changed.html:178
#, python-format
msgid ""
"The password for your account (%(username)s) on Baserow "
"(%(baserow_embedded_share_hostname)s) has been successfully changed."
msgstr ""
"La password del tuo account (%(username)s) su Baserow "
"(%(baserow_embedded_share_hostname)s) è stata modificata con successo."

#: src/baserow/core/templates/baserow/core/user/password_changed.html:183
msgid ""
"If you did not make this change, please contact your administrator "
"immediately to secure your account."
msgstr ""
"Se non hai effettuato tu questa modifica, contatta immediatamente il tuo "
"amministratore per proteggere il tuo account."

#: src/baserow/core/templates/baserow/core/user/reset_password.html:173
#: src/baserow/core/templates/baserow/core/user/reset_password.html:192
msgid "Reset password"
msgstr "Reimposta password"

#: src/baserow/core/templates/baserow/core/user/reset_password.html:178
#, python-format
msgid ""
"A password reset was requested for your account (%(username)s) on Baserow "
"(%(baserow_embedded_share_hostname)s). If you did not authorize this, you "
"may simply ignore this email."
msgstr ""
"È stata richiesta la reimpostazione della password per il tuo account "
"(%(username)s) su Baserow (%(baserow_embedded_share_hostname)s). Se non hai "
"autorizzato questa richiesta, puoi semplicemente ignorare questa email."

#: src/baserow/core/templates/baserow/core/user/reset_password.html:183
#, python-format
msgid ""
"To continue with your password reset, simply click the button below, and you "
"will be able to change your password. This link will expire in %(hours)s "
