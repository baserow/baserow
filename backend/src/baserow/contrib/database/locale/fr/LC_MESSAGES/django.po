msgstr "Les données du webhook %(name)s sont trop volumineuses."

#: src/baserow/contrib/database/webhooks/notification_types.py:127
#, python-format
msgid ""
"The payload for the %(name)s webhook with event ID %(event_id)s was too "
"large. The content has been split into multiple batches, but data above the "
"batch limit of %(batch_limit)s was discarded."
msgstr ""
"Les données du webhook %(name)s avec l'ID d'événement %(event_id)s étaient "
"trop volumineuses. Le contenu a été divisé en plusieurs lots, mais les "
"données dépassant la limite de %(batch_limit)s lots ont été ignorées."

