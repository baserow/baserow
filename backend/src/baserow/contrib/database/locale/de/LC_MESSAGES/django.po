#: src/baserow/contrib/database/webhooks/notification_types.py:120
#, python-format
msgid "%(name)s webhook payload too large."
msgstr "Webhook-Payload von %(name)s ist zu groß."

#: src/baserow/contrib/database/webhooks/notification_types.py:127
#, python-format
msgid ""
"The payload for the %(name)s webhook with event ID %(event_id)s was too "
"large. The content has been split into multiple batches, but data above the "
"batch limit of %(batch_limit)s was discarded."
msgstr ""
"Die Payload des Webhooks %(name)s mit der Ereignis-ID %(event_id)s war zu "
"groß. Der Inhalt wurde in mehrere Batches aufgeteilt, aber Daten oberhalb "
"des Batch-Limits von %(batch_limit)s wurden verworfen."
