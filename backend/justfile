# Baserow Backend Justfile
# Uses uv for Python package management

# Environment file configuration:
# - .env.dev : Local development (recommended, gitignored)
# - .env       : Docker/production (used by docker-compose)
# - .env.test  : Test environment
#
# To use a specific env file: ENVFILE=.env.test just <recipe>
# Default: loads .env.dev if exists, otherwise .env

# Note: just doesn't support dynamic dotenv-filename, so we handle env loading in recipes
# For automatic env loading, use direnv with .envrc

# Default recipe - show help
default:
    @just --list

# Variables
python_version := "3.11"

# Venv location: use UV_PROJECT_ENVIRONMENT if set (e.g., in Docker), otherwise default to project root
venv_dir := env("UV_PROJECT_ENVIRONMENT", justfile_directory() / "../.venv")

# Export for uv to use
export UV_PROJECT_ENVIRONMENT := venv_dir

# Use --active to respect VIRTUAL_ENV from direnv, since venv may be in parent dir
uv_run := "uv run --active"

# Helper to load .env.local if present (for local dev without direnv)
# Include this at the start of bash recipes that need env vars
_load_env := 'if [ -f "../.env.local" ]; then set -a; source "../.env.local"; set +a; fi'

# Source directories
backend_source_dirs := "src/ ../premium/backend/src/ ../enterprise/backend/src/"
backend_tests_dirs := "tests/ ../premium/backend/tests/ ../enterprise/backend/tests/"
backend_tests_dirs_from_root := "backend/tests/ premium/backend/tests/ enterprise/backend/tests/"

# Django settings
django_settings := env("DJANGO_SETTINGS_MODULE", "baserow.config.settings.dev")
export DJANGO_SETTINGS_MODULE := django_settings
runserver_bind := env("RUNSERVER_BIND", "0.0.0.0:8000")

# Log files for dev servers (used by logs command)
log_file := "/tmp/baserow-backend.log"
celery_log_file := "/tmp/baserow-celery.log"

# Pytest settings
pytest_splits := env("PYTEST_SPLITS", "1")
pytest_split_group := env("PYTEST_SPLIT_GROUP", "1")
pytest_extra_args := env("PYTEST_EXTRA_ARGS", "")

# =============================================================================
# Setup & Installation
# =============================================================================

# Initialize: create Python venv with uv, lock deps, and install everything
init: _setup-env _create-venv lock sync
    @echo ""
    @echo "Backend initialized successfully!"
    @echo ""
    @echo "To activate the virtual environment:"
    @echo "  source {{ venv_dir }}/bin/activate"
    @echo ""
    @echo "Or use direnv (recommended):"
    @echo "  direnv allow"
    @echo ""
    @echo "Or run commands directly with:"
    @echo "  just run <command>"
    @echo "  uv run <command>"

# Copy .env.local.example to .env.local if it doesn't exist (in project root)
_setup-env:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f ../.env.local ] && [ -f ../.env.local.example ]; then
        echo "Creating .env.local from .env.local.example..."
        cp ../.env.local.example ../.env.local
        echo "Please review and edit .env.local as needed."
    fi

# Print the command to activate the virtual environment
activate:
    @echo "Run this command to activate the virtual environment:"
    @echo ""
    @echo "  source {{ venv_dir }}/bin/activate"
    @echo ""
    @echo "Or if you have direnv installed, run:"
    @echo "  direnv allow"

# Create Python 3.11 virtual environment with uv
_create-venv:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -d "{{ venv_dir }}" ]; then
        echo "Creating Python {{ python_version }} virtual environment..."
        uv venv --python {{ python_version }} "{{ venv_dir }}"
    else
        echo "Virtual environment already exists at {{ venv_dir }}"
    fi

# Install dependencies (includes baserow + premium + enterprise via uv.sources)
install: _create-venv sync
    @echo "Baserow installed successfully!"

# =============================================================================
# Dependency Management (uv native)
# =============================================================================

# Generate/update uv.lock from pyproject.toml
lock:
    uv lock

# Sync dependencies from uv.lock (production only)
sync-prod:
    uv sync --frozen --no-dev

# Sync all dependencies from uv.lock (including dev)
sync:
    uv sync --frozen

# Upgrade all dependencies and regenerate lock file
deps-upgrade:
    uv lock --upgrade

# Upgrade a specific dependency
deps-upgrade-package package:
    uv lock --upgrade-package {{ package }}

# Add a new dependency
deps-add package:
    uv add {{ package }}

# Add a new dev dependency
deps-add-dev package:
    uv add --dev {{ package }}

# Remove a dependency
deps-remove package:
    uv remove {{ package }}

