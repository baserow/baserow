# Run development server (Django)
run-dev-server: _check-dev
    {{ uv_run }} baserow runserver {{ runserver_bind }}

# Celery settings
celery_log_level := env("CELERY_LOG_LEVEL", "INFO")  # INFO default, override with CELERY_LOG_LEVEL=DEBUG
# Use 'solo' pool on macOS to avoid fork() issues causing SIGSEGV
# Options: solo (single-threaded), threads, prefork (default, problematic on macOS)
celery_pool := env("CELERY_POOL", "solo")

# Run all Celery workers and beat together for development
run-dev-celery: _check-dev
    #!/usr/bin/env bash
    set -euo pipefail

    # Color codes for different processes
    CYAN='\033[0;36m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    NC='\033[0m' # No Color

    # Function to prefix output with colored process name
    prefix_output() {
        local prefix="$1"
        local color="$2"
        while IFS= read -r line; do
            echo -e "${color}[${prefix}]${NC} $line"
        done
    }

    cleanup() {
        echo ""
        echo "Stopping all Celery processes..."
        kill $WORKER_PID $EXPORT_PID $BEAT_PID 2>/dev/null || true
        wait $WORKER_PID $EXPORT_PID $BEAT_PID 2>/dev/null || true
        echo "All Celery processes stopped."
    }
    trap cleanup EXIT INT TERM

    echo "Starting Celery worker (celery,automation_workflow queues)..."
    {{ uv_run }} celery -A baserow worker -Q celery,automation_workflow -n default-worker@%h -l {{ celery_log_level }} --pool {{ celery_pool }} 2>&1 | prefix_output "WORKER" "$CYAN" &
    WORKER_PID=$!

    echo "Starting Celery export worker (export queue)..."
    {{ uv_run }} celery -A baserow worker -Q export -n export-worker@%h -l {{ celery_log_level }} --pool {{ celery_pool }} 2>&1 | prefix_output "EXPORT" "$GREEN" &
    EXPORT_PID=$!

    echo "Starting Celery beat with redbeat scheduler..."
    {{ uv_run }} celery -A baserow beat -l {{ celery_log_level }} -S redbeat.RedBeatScheduler 2>&1 | prefix_output "BEAT" "$YELLOW" &
    BEAT_PID=$!

    echo ""
    echo "All Celery processes started (pool: {{ celery_pool }}). Press Ctrl+C to stop."
    echo ""

    wait

# Run any command in the venv
run *args: _check-dev
    {{ uv_run }} {{ args }}

# Run Django manage.py commands (e.g., just b manage makemigrations)
manage *args: _check-dev
