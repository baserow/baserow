# Baserow Backend Justfile
# Uses uv for Python package management

# Environment file configuration:
# - .env.local : Local development (recommended, gitignored)
# - .env       : Docker/production (used by docker-compose)
# - .env.test  : Test environment
#
# To use a specific env file: ENVFILE=.env.test just <recipe>
# Default: loads .env.local if exists, otherwise .env

# Note: just doesn't support dynamic dotenv-filename, so we handle env loading in recipes
# For automatic env loading, use direnv with .envrc

# Default recipe - show help
default:
    @just --list

# Variables
# Venv is in project root, shared across all components
venv_dir := justfile_directory() / "../.venv"
python_version := "3.11"

# Use --active to respect VIRTUAL_ENV from direnv, since venv is in parent dir
uv_run := "uv run --active"

# Source directories
backend_source_dirs := "src/ ../premium/backend/src/ ../enterprise/backend/src/"
backend_tests_dirs := "tests/ ../premium/backend/tests/ ../enterprise/backend/tests/"
backend_tests_dirs_from_root := "backend/tests/ premium/backend/tests/ enterprise/backend/tests/"

# Django settings
django_settings := env("DJANGO_SETTINGS_MODULE", "baserow.config.settings.dev")
runserver_bind := env("RUNSERVER_BIND", "0.0.0.0:8000")

# Pytest settings
pytest_splits := env("PYTEST_SPLITS", "1")
pytest_split_group := env("PYTEST_SPLIT_GROUP", "1")
pytest_extra_args := env("PYTEST_EXTRA_ARGS", "")

# =============================================================================
# Setup & Installation
# =============================================================================

# Initialize: create Python 3.11 venv with uv, lock deps, and install everything
init: _setup-env _create-venv lock sync _install-editable
    @echo ""
    @echo "Backend initialized successfully!"
    @echo ""
    @echo "To activate the virtual environment:"
    @echo "  source {{ venv_dir }}/bin/activate"
    @echo ""
    @echo "Or use direnv (recommended):"
    @echo "  direnv allow"
    @echo ""
    @echo "Or run commands directly with:"
    @echo "  just run <command>"
    @echo "  uv run <command>"

# Copy .env.local.example to .env.local if it doesn't exist (in project root)
_setup-env:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f ../.env.local ] && [ -f ../.env.local.example ]; then
        echo "Creating .env.local from .env.local.example..."
        cp ../.env.local.example ../.env.local
        echo "Please review and edit .env.local as needed."
    fi

# Print the command to activate the virtual environment
activate:
    @echo "Run this command to activate the virtual environment:"
    @echo ""
    @echo "  source {{ venv_dir }}/bin/activate"
    @echo ""
    @echo "Or if you have direnv installed, run:"
    @echo "  direnv allow"

# Open a bash shell with the virtual environment activated
venv-shell: _check-dev
    @echo "Starting shell with virtual environment activated..."
    @VIRTUAL_ENV="{{ venv_dir }}" PATH="{{ venv_dir }}/bin:$PATH" $SHELL

# Create Python 3.11 virtual environment with uv
_create-venv:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -d "{{ venv_dir }}" ]; then
        echo "Creating Python {{ python_version }} virtual environment..."
        uv venv --python {{ python_version }} "{{ venv_dir }}"
    else
        echo "Virtual environment already exists at {{ venv_dir }}"
    fi

# Install only OSS version (no premium/enterprise)
install-oss: _create-venv sync _install-oss
    @echo "Baserow OSS installed successfully!"

# Install full version (OSS + premium + enterprise)
install: _create-venv sync _install-editable
    @echo "Baserow (full) installed successfully!"

# Install premium/enterprise add-ons only (requires install-oss first)
install-extra: _install-extra

_install-oss:
    uv pip install --python "{{ venv_dir }}/bin/python" -e .

_install-extra:
    uv pip install --python "{{ venv_dir }}/bin/python" -e ../premium/backend/
    uv pip install --python "{{ venv_dir }}/bin/python" -e ../enterprise/backend/

_install-editable: _install-oss _install-extra

# =============================================================================
# Dependency Management (uv native)
# =============================================================================

# Generate/update uv.lock from pyproject.toml
lock:
    uv lock

# Sync dependencies from uv.lock (production only)
sync-prod:
    uv sync --frozen --no-dev

# Sync all dependencies from uv.lock (including dev)
sync:
    uv sync --frozen

# Upgrade all dependencies and regenerate lock file
deps-upgrade:
    uv lock --upgrade

# Upgrade a specific dependency
deps-upgrade-package package:
    uv lock --upgrade-package {{ package }}

# Add a new dependency
deps-add package:
    uv add {{ package }}

# Add a new dev dependency
deps-add-dev package:
    uv add --dev {{ package }}

# Remove a dependency
deps-remove package:
    uv remove {{ package }}

# =============================================================================
# Code Quality & Linting
# =============================================================================

# Run all lint checks
lint: _check-dev
    {{ uv_run }} flake8 {{ backend_source_dirs }} {{ backend_tests_dirs }}
    {{ uv_run }} black {{ backend_source_dirs }} {{ backend_tests_dirs }} --check --config=pyproject.toml
    {{ uv_run }} isort --check --skip generated {{ backend_source_dirs }} {{ backend_tests_dirs }}
    DJANGO_SETTINGS_MODULE={{ django_settings }} {{ uv_run }} baserow makemigrations --dry-run --check
    {{ uv_run }} bandit -r --exclude src/baserow/test_utils,src/baserow/config/settings/local.py {{ backend_source_dirs }}

# Alias for lint
lint-python: lint

# Format code with black
format: _check-dev
    {{ uv_run }} black --config=pyproject.toml {{ backend_source_dirs }} {{ backend_tests_dirs }}

# Sort imports with isort
sort: _check-dev
    {{ uv_run }} isort --skip generated --overwrite-in-place {{ backend_source_dirs }} {{ backend_tests_dirs }}

# Fix code style (sort imports + format)
lint-fix: sort format

# Alias for lint-fix
fix: lint-fix

