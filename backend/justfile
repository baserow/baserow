# Build Docker image
docker-build:
    docker build .

# =============================================================================
# Test Database (ramdisk)
# =============================================================================

# Test DB settings
test_db_name := "baserow-test-db"
test_db_port := env("TEST_DB_PORT", "5433")
test_db_image := "pgvector/pgvector:pg13"

# Start a PostgreSQL container with tmpfs (ramdisk) for fast tests
# Always recreates to ensure fresh tmpfs
test-db-start:
    #!/usr/bin/env bash
    set -euo pipefail
    # Always remove and recreate to get fresh tmpfs
    if docker ps -a --format '{{"{{"}}.Names{{"}}"}}' | grep -q "^{{ test_db_name }}$"; then
        echo "Removing existing container to get fresh tmpfs..."
        docker rm -f {{ test_db_name }} > /dev/null
    fi
    echo "Creating test database container with tmpfs..."
    docker run -d \
        --name {{ test_db_name }} \
        -e POSTGRES_USER=baserow \
        -e POSTGRES_PASSWORD=baserow \
        -e POSTGRES_DB=baserow \
        -p {{ test_db_port }}:5432 \
        --tmpfs /var/lib/postgresql/data:size=8G \
        {{ test_db_image }} \
        -c shared_buffers=512MB \
        -c fsync=off \
        -c full_page_writes=off \
        -c synchronous_commit=off \
        -c max_locks_per_transaction=512 \
        -c logging_collector=off \
        -c log_statement=none \
        -c log_duration=off \
        -c log_min_duration_statement=-1 \
        -c log_checkpoints=off \
        -c log_connections=off \
        -c log_disconnections=off \
        -c log_lock_waits=off \
        -c log_temp_files=-1 \
        -c checkpoint_timeout=1h \
        -c max_wal_size=10GB \
        -c min_wal_size=1GB \
        -c wal_level=minimal \
        -c max_wal_senders=0 \
        -c autovacuum=off \
        -c random_page_cost=1.0 \
        -c effective_io_concurrency=200 \
        -c work_mem=256MB \
        -c maintenance_work_mem=512MB
    echo "Test database running on port {{ test_db_port }}"

# =============================================================================
# Cleanup
# =============================================================================

# Remove build artifacts
clean:
    rm -rf dist/*

# Remove virtual environment
venv-clean:
    rm -rf "{{ venv_dir }}"

# Remove lock file
lock-clean:
    rm -f uv.lock

# Remove all (build artifacts + venv + lock)
clean-all: clean venv-clean lock-clean

# =============================================================================
# Internal helpers
# =============================================================================

# Check if dev environment is set up, install if not
_check-dev:
    #!/usr/bin/env bash
    if [ ! -f "{{ venv_dir }}/bin/python" ] || [ ! -f "uv.lock" ]; then
        echo "Dev environment not found, running init..."
        just init
    fi
