# Run all lint checks
lint: _check-dev
    {{ uv_run }} flake8 {{ backend_source_dirs }} {{ backend_tests_dirs }}
    {{ uv_run }} black {{ backend_source_dirs }} {{ backend_tests_dirs }} --check --config=pyproject.toml
    {{ uv_run }} isort --check --skip generated {{ backend_source_dirs }} {{ backend_tests_dirs }}
    DJANGO_SETTINGS_MODULE={{ django_settings }} {{ uv_run }} baserow makemigrations --dry-run --check
    {{ uv_run }} bandit -r --exclude src/baserow/test_utils,src/baserow/config/settings/local.py {{ backend_source_dirs }}

# Alias for lint
lint-python: lint

# Format code with black
format: _check-dev
    {{ uv_run }} black --config=pyproject.toml {{ backend_source_dirs }} {{ backend_tests_dirs }}

# Sort imports with isort
sort: _check-dev
    {{ uv_run }} isort --skip generated --overwrite-in-place {{ backend_source_dirs }} {{ backend_tests_dirs }}

# Fix code style (sort imports + format)
lint-fix: sort format

# Alias for lint-fix
fix: lint-fix

