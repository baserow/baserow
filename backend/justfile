# Run automation tests
test-automation: _check-dev
    {{ uv_run }} pytest tests/baserow/contrib/integrations tests/baserow/contrib/automation

# Run automation tests in parallel
test-automation-parallel: _check-dev
    {{ uv_run }} pytest tests/baserow/contrib/integrations tests/baserow/contrib/automation -n 10

