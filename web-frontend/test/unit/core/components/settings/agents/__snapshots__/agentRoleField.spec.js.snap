exports[`AgentRoleField > shows the current role as editable when agent updates are permitted 1`] = `"<div><button type="button" class="button button--regular button--secondary member-role-field__link" aria-haspopup="true"><i class="button__icon iconoir-group"></i><span class="button__label">Member</span><i class="button__icon iconoir-nav-arrow-down"></i></button><button class="change-role" roles="[object Object],[object Object]" workspace="[object Object]" role-value-column="role_uid" show-commercial-info="false"></button></div>"`;

exports[`AgentRoleField > shows the current role as read-only without agent update permission 1`] = `
