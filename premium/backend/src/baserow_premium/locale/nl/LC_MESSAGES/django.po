#: src/baserow_premium/row_comments/notification_types.py:128
#, python-format
msgid "%(user)s posted a comment in row %(row_name)s in %(table_name)s."
msgstr ""
"%(user)s heeft een opmerking geplaatst in rij %(row_name)s in "
"%(table_name)s."

#: src/baserow_premium/views/actions.py:26
