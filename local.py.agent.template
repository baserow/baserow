# Auto-generated by `just agent up` — creates a workspace named after the branch.
import traceback

from django.db.models.signals import post_migrate


def setup_agent_workspace(*args, **kwargs):
    try:
        from django.contrib.auth import get_user_model

        from baserow.core.models import Workspace

        User = get_user_model()
        workspace_name = "__AGENT_NAME__"

        user = User.objects.filter(email="dev@baserow.io").first()
        if user is None:
            return

        if Workspace.objects.filter(name=workspace_name).exists():
            return

        from baserow.core.handler import CoreHandler

        CoreHandler().create_workspace(user=user, name=workspace_name)
        print(f"\033[93mCreated workspace: {workspace_name}\033[0m")
    except Exception:
        traceback.print_exc()


post_migrate.connect(setup_agent_workspace, dispatch_uid="setup_agent_workspace")
