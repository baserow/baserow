msgstr "La sincronizzazione periodica dei dati %(name)s è stata disattivata."

#: src/baserow_enterprise/data_sync/notification_types.py:115
msgid ""
"The periodic data sync has been disabled because the workspace no longer has "
"a valid license for data sync features. Please update your license to "
"restore automatic syncing."
msgstr ""
"La sincronizzazione periodica dei dati è stata disattivata perché il "
"progetto non ha più una licenza valida per le funzionalità di "
"sincronizzazione dei dati. Aggiorna la tua licenza per ripristinare la "
"sincronizzazione automatica."

#: src/baserow_enterprise/data_sync/notification_types.py:121
#, python-format
msgid ""
"The periodic data sync failed more than %(max_failures)s consecutive times "
"and was therefore deactivated."
msgstr ""
"La sincronizzazione periodica dei dati ha fallito più di %(max_failures)s "
"volte consecutive ed è stata quindi disattivata."

#: src/baserow_enterprise/data_sync/notification_types.py:150
#, python-format
msgid "%(table_name)s two-way sync update failed."
msgstr ""
"Aggiornamento della sincronizzazione bidirezionale di %(table_name)s non "
"riuscito."

#: src/baserow_enterprise/data_sync/notification_types.py:180
#, python-format
msgid "%(table_name)s two-way sync deactivated."
msgstr "Sincronizzazione bidirezionale di %(table_name)s disattivata."

#: src/baserow_enterprise/data_sync/notification_types.py:187
msgid ""
"The two-way sync was deactivated because an update failed too many times "
"consecutively. Please manually sync, and reactivate when the problem is "
"resolved."
msgstr ""
"La sincronizzazione bidirezionale è stata disattivata perché un "
"aggiornamento è fallito troppe volte consecutive. Sincronizza manualmente e "
"riattivala quando il problema sarà risolto."

