#, python-format
msgid "%(name)s periodic data sync has been deactivated."
msgstr "La synchronisation périodique des données %(name)s a été désactivée."

#: src/baserow_enterprise/data_sync/notification_types.py:115
msgid ""
"The periodic data sync has been disabled because the workspace no longer has "
"a valid license for data sync features. Please update your license to "
"restore automatic syncing."
msgstr ""
"La synchronisation périodique des données a été désactivée car le projet ne "
"dispose plus d'une licence valide pour les fonctionnalités de "
"synchronisation. Mettez à jour votre licence pour rétablir la "
"synchronisation automatique."

#: src/baserow_enterprise/data_sync/notification_types.py:121
#, python-format
msgid ""
"The periodic data sync failed more than %(max_failures)s consecutive times "
"and was therefore deactivated."
msgstr ""
"La synchronisation périodique des données a échoué plus de %(max_failures)s "
"fois consécutives et a donc été désactivée."

#: src/baserow_enterprise/data_sync/notification_types.py:150
#, python-format
msgid "%(table_name)s two-way sync update failed."
msgstr ""
"Échec de la mise à jour de la synchronisation bidirectionnelle de "
"%(table_name)s."

#: src/baserow_enterprise/data_sync/notification_types.py:180
#, python-format
msgid "%(table_name)s two-way sync deactivated."
msgstr "Synchronisation bidirectionnelle de %(table_name)s désactivée."

#: src/baserow_enterprise/data_sync/notification_types.py:187
msgid ""
"The two-way sync was deactivated because an update failed too many times "
"consecutively. Please manually sync, and reactivate when the problem is "
"resolved."
msgstr ""
"La synchronisation bidirectionnelle a été désactivée car une mise à jour a "
"échoué trop de fois consécutives. Effectuez une synchronisation manuelle et "
"réactivez-la une fois le problème résolu."

