# Auto-generated by `just agent up` for instance: __AGENT_NAME__
DJANGO_SETTINGS_MODULE=baserow.config.settings.dev

SECRET_KEY=baserow-agent-__AGENT_NAME__

# Shared PostgreSQL (feature-specific DB, exposed on host port 5431)
DATABASE_HOST=localhost
DATABASE_PORT=5431
DATABASE_NAME=baserow-__AGENT_NAME__
DATABASE_PASSWORD=baserow

# Shared Redis
REDIS_HOST=localhost
REDIS_PASSWORD=baserow

# URLs
BASEROW_PUBLIC_URL=http://__AGENT_NAME__.localhost:__PROXY_PORT__
BASEROW_EXTRA_ALLOWED_HOSTS=__AGENT_NAME__.localhost

# Shared Mailhog
EMAIL_HOST=localhost
EMAIL_PORT=1025

# Fast startup
SYNC_TEMPLATES_ON_STARTUP=false
MIGRATE_ON_STARTUP=false
